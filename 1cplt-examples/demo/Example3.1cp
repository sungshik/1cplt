role* @node(neigh: @node, x: number, y: number) {
  main:
    x -> neigh.y |> forward

  forward:
    if
      x < y
    then
      y -> neigh.y |> forward
    // else
    //   if x == y then \echo "Leader!"
}

#compile

#execute
process @node[1](neigh = @node[2], x = 11, y = 0)
process @node[2](neigh = @node[3], x = 17, y = 0)
process @node[3](neigh = @node[1], x = 13, y = 0)
