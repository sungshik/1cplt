role @client(ns: number[], n?: number | null, res?: {fib: number}, ss: @server[], s?: @server | null) {
  main:
    n := ns[0] ;
    s := ss[ns.length % ss.length] ;
    if n != null && s != null then {
      ns := ns.slice(1) ;
      {n: n} -> s.req |>
        fib
    }
}

role* @server(req?: {n: number}, res?: {fib: number}, x?: number, y?: number, i?: number) {
  fib:
    if req != undefined then {
      if req.n <= 1 then
        res := {fib: req.n}
      else {
        res := {fib: 2} ;
        x := 0 ;
        y := 1 ;
        i := 2 ;
        while i <= req.n do {
          res := {fib: x + y} ;
          x := y ;
          y := res.fib ;
          i := i + 1
        }
      } ;
      res -> @client.res |> {
        \echo res ;
        main
      }
    }
}

process @client(ns = [5, 6, 7], ss = [@server[1], @server[2]])
process @server[1]()
process @server[2]()

#analyze
#compile
#execute
