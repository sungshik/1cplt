role* @node(
  id: number,
  ns: @node[],
  messages: {id: number; n: @node}[] = [], // History of all messages received
  message?: {id: number; n: @node},
  family?: @node[],
  parent?: @node | null
) {
  main:
    foreach<@node> n in ns do
      {id: id, n: self} -> n.message |> recv

  recv:
    if message != undefined then
      if id <= message.id then {
        messages := messages.concat([message]) ;

        family := [] ; // Each neighbour from which was received in this wave
        foreach<{id: number; n: @node}> m in messages do
          if message.id == m.id then family := family.concat([m.n]) ;

        parent := family[0] ; // First neighbour from which was received in this wave
        if parent != null then {

          // Start participation in this wave by forwarding to non-parents
          if message.id != id && family.length == 1 then
            foreach<@node> nonParent in ns do
              if parent.rank != nonParent.rank then
                {id: message.id, n: self} -> nonParent.message |> recv ;

          // Finish participation in this wave by forwarding to parent
          if message.id != id && family.length == ns.length then
            {id: message.id, n: self} -> parent.message |> recv ;

          // Declare leadership
          if message.id == id && family.length == ns.length then
            \echo "Leader!"
        }
      }
}

